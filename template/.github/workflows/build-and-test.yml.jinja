name: Build and Test

on:
  workflow_dispatch:
  push:
  pull_request:

permissions:
  contents: read

jobs:
  validate:
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-2022]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '{{ python_version.replace(">=", "") }}'
          cache: pip
          cache-dependency-path: scripts/tool-requirements.txt
      - uses: actions/cache@v4
        with:
          path: |
            ~/.cache/vcpkg/archives
            ~/AppData/Local/vcpkg/archives
          key: vcpkg-{% raw %}${{ runner.os }}{% endraw %}-{% raw %}${{ hashFiles('vcpkg-configuration.json', 'vcpkg-ports/**', 'scripts/tool-requirements.txt') }}{% endraw %}
      - name: Bootstrap pinned tools and vcpkg
        run: python scripts/bootstrap.py
      - name: Validate
        run: python scripts/validate.py --wheel
