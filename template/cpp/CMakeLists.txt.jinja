cmake_minimum_required(VERSION {{ cmake_min_version }})
project({{ module_name }}_core VERSION ${PROJECT_VERSION} LANGUAGES CXX)

include(GNUInstallDirs)
include(CMakePackageConfigHelpers)

file(GLOB CORE_SOURCES CONFIGURE_DEPENDS src/*.cpp)
add_library({{ module_name }}_core_static STATIC ${CORE_SOURCES})
set_target_properties(
    {{ module_name }}_core_static
    PROPERTIES POSITION_INDEPENDENT_CODE ON EXPORT_NAME core
)

target_include_directories(
    {{ module_name }}_core_static
    PUBLIC
        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
        $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
)
target_compile_features({{ module_name }}_core_static PUBLIC cxx_std_{{ cpp_standard }})

install(TARGETS {{ module_name }}_core_static EXPORT {{ module_name }}_coreTargets
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
)
install(DIRECTORY include/ DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
set(package_dir "${CMAKE_INSTALL_LIBDIR}/cmake/{{ module_name }}_core")
configure_package_config_file("${CMAKE_SOURCE_DIR}/cmake/LibraryConfig.cmake.in"
    "${CMAKE_CURRENT_BINARY_DIR}/{{ module_name }}_coreConfig.cmake"
    INSTALL_DESTINATION "${package_dir}"
)
write_basic_package_version_file("${CMAKE_CURRENT_BINARY_DIR}/{{ module_name }}_coreConfigVersion.cmake"
    VERSION ${PROJECT_VERSION} COMPATIBILITY SameMajorVersion
)
install(EXPORT {{ module_name }}_coreTargets NAMESPACE {{ module_name }}_core:: DESTINATION "${package_dir}")
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/{{ module_name }}_coreConfig.cmake"
    "${CMAKE_CURRENT_BINARY_DIR}/{{ module_name }}_coreConfigVersion.cmake" DESTINATION "${package_dir}"
)

if(BUILD_PYTHON_BINDINGS)

include(FetchContent)
FetchContent_Declare(
    pybind11
    GIT_REPOSITORY https://github.com/pybind/pybind11.git
    GIT_TAG v3.0.1
)
FetchContent_MakeAvailable(pybind11)

set(PYBIND11_FINDPYTHON ON)
pybind11_add_module({{ module_name }}_core bindings/hello_bindings.cpp)
target_link_libraries({{ module_name }}_core PRIVATE {{ module_name }}_core_static)

# Put the extension directly beside the Python package sources on every
# platform and for every multi-config build configuration. This avoids
# generator-specific copy logic in build.py.
set(PYTHON_PACKAGE_DIR "${CMAKE_SOURCE_DIR}/src/{{ module_name }}")
set_target_properties(
    {{ module_name }}_core
    PROPERTIES
        LIBRARY_OUTPUT_DIRECTORY "${PYTHON_PACKAGE_DIR}"
        RUNTIME_OUTPUT_DIRECTORY "${PYTHON_PACKAGE_DIR}"
)

foreach(config Debug Release RelWithDebInfo MinSizeRel)
    string(TOUPPER "${config}" config_upper)
    set_target_properties(
        {{ module_name }}_core
        PROPERTIES
            LIBRARY_OUTPUT_DIRECTORY_${config_upper} "${PYTHON_PACKAGE_DIR}"
            RUNTIME_OUTPUT_DIRECTORY_${config_upper} "${PYTHON_PACKAGE_DIR}"
    )
endforeach()
endif()
