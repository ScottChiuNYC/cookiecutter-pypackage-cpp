cmake_minimum_required(VERSION {{ cmake_min_version }})
project({{ module_name }}_core_test)

find_package(GTest CONFIG REQUIRED)

# Add all .cpp files in this directory as test sources
file(GLOB TEST_SOURCES *.cpp)
add_executable({{ module_name }}_core_test ${TEST_SOURCES})

target_include_directories({{ module_name }}_core_test PRIVATE
    ${CMAKE_SOURCE_DIR}/cpp/include
)

target_link_libraries({{ module_name }}_core_test PRIVATE
    {{ module_name }}_core_static
    GTest::gtest
    GTest::gtest_main
    # GTest::gmock
    # GTest::gmock_main
)

add_test(NAME {{ module_name }}_core_test COMMAND {{ module_name }}_core_test)
