[tool.poetry]
name = "{{ module_name }}"
version = "{{ version }}"
description = {{ description | tojson }}
authors = [{{ (author_name ~ " <" ~ author_email ~ ">") | tojson }}]
readme = "README.md"

include = [
    { path = "scripts/*.py", format = "sdist" },
    { path = "scripts/tool-requirements.txt", format = "sdist" },
    # Native build inputs required when rebuilding from the source distribution.
    { path = "CMakeLists.txt", format = "sdist" },
    { path = "CMakePresets.json", format = "sdist" },
    { path = "cmake/*", format = "sdist" },
    { path = "build.py", format = "sdist" },
    { path = "vcpkg.json", format = "sdist" },
    { path = "vcpkg-configuration.json", format = "sdist" },
    { path = "vcpkg-ports/gtest/*", format = "sdist" },
    { path = "vcpkg-ports/{{ vcpkg_port_name }}/*", format = "sdist" },
    { path = "cpp/CMakeLists.txt", format = "sdist" },
    { path = "cpp/bindings/*.*", format = "sdist" },
    { path = "cpp/include/{{ module_name }}_core/*.*", format = "sdist" },
    { path = "cpp/src/*.*", format = "sdist" },
    { path = "examples/cpp/*.*", format = "sdist" },
    { path = "tests/cpp/*.*", format = "sdist" },
    { path = "tests/vcpkg-consumer/*", format = "sdist" },
    # C extensions must be included in the wheel distribution.
    { path = "src/{{ module_name }}/*.pyd", format = "wheel" },
    { path = "src/{{ module_name }}/*.so", format = "wheel" },
]
exclude = [
    "cpp/*",
]

[tool.poetry.build]
generate-setup-file = false
script = "build.py"

[tool.poetry.dependencies]
python = "{{ python_version }}"

[tool.poetry.group.dev.dependencies]
pytest = "^7.0"

[build-system]
requires = ["poetry-core==2.5.0", "cmake==3.31.10", "ninja==1.13.2"]
build-backend = "poetry.core.masonry.api"
